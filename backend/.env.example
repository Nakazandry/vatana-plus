# Never commit backend/.env. Define these values in Render's environment variables.
PORT=5000
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
# Comma-separated list of browser origins permitted to call the API.
CORS_ALLOWED_ORIGINS=https://vatana-plus.vercel.app
